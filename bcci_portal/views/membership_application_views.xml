<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- List View -->
  <record id="view_bcci_membership_application_list" model="ir.ui.view">
    <field name="name">bcci.membership.application.list</field>
    <field name="model">bcci.membership.application</field>
    <field name="arch" type="xml">
      <list string="Membership Applications" decoration-success="status == 'Approved'"
            decoration-warning="status == 'Pending'" decoration-danger="status == 'Rejected'">
        <field name="app_id"/>
        <field name="company"/>
        <field name="rep_name"/>
        <field name="email"/>
        <field name="phone"/>
        <field name="membership_type"/>
        <field name="enterprise_type"/>
        <field name="status"/>
        <field name="submitted_at"/>
        <field name="days_remaining" optional="hide"/>
      </list>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_bcci_membership_application_form" model="ir.ui.view">
    <field name="name">bcci.membership.application.form</field>
    <field name="model">bcci.membership.application</field>
    <field name="arch" type="xml">
      <form string="Membership Application">
        <header>
          <button name="action_approve" type="object" string="✅ Approve Membership"
                  class="btn-primary" attrs="{'invisible': [('status', '=', 'Approved')]}"/>
          <button name="action_reject" type="object" string="❌ Reject"
                  attrs="{'invisible': [('status', 'in', ['Rejected'])]}"/>
          <field name="status" widget="statusbar" statusbar_visible="Pending,Approved,Rejected"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="company" placeholder="Company Name"/></h1>
            <h2><field name="app_id" readonly="1"/></h2>
          </div>
          <group>
            <group string="Company Details">
              <field name="legal_status"/>
              <field name="enterprise_type"/>
              <field name="membership_type"/>
              <field name="gst_no"/>
              <field name="pan_no"/>
              <field name="website"/>
            </group>
            <group string="Representative">
              <field name="rep_name"/>
              <field name="rep_designation"/>
              <field name="email"/>
              <field name="phone"/>
            </group>
          </group>
          <group>
            <group string="Address">
              <field name="address"/>
              <field name="city"/>
              <field name="pincode"/>
            </group>
            <group string="Payment">
              <field name="payment_ref"/>
              <field name="payment_proof" widget="image"/>
            </group>
          </group>
          <group string="Membership Validity" attrs="{'invisible': [('status', '!=', 'Approved')]}">
            <field name="approved_at" readonly="1"/>
            <field name="approved_by" readonly="1"/>
            <field name="valid_until" readonly="1"/>
            <field name="days_remaining" readonly="1"/>
            <field name="validity_state" readonly="1"/>
            <field name="renewal_years"/>
          </group>
          <group string="Business Description">
            <field name="business_services" nolabel="1" colspan="2"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_bcci_membership_applications" model="ir.actions.act_window">
    <field name="name">Membership Applications</field>
    <field name="res_model">bcci.membership.application</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_status_pending': 1}</field>
  </record>

  <!-- Search View with filters -->
  <record id="view_bcci_membership_search" model="ir.ui.view">
    <field name="name">bcci.membership.application.search</field>
    <field name="model">bcci.membership.application</field>
    <field name="arch" type="xml">
      <search>
        <field name="company"/>
        <field name="email"/>
        <field name="app_id"/>
        <filter name="status_pending"  string="Pending"  domain="[('status','=','Pending')]"/>
        <filter name="status_approved" string="Approved" domain="[('status','=','Approved')]"/>
        <filter name="status_rejected" string="Rejected" domain="[('status','=','Rejected')]"/>
        <group expand="0" string="Group By">
          <filter string="Status"      name="group_status"      context="{'group_by': 'status'}"/>
          <filter string="Membership"  name="group_type"        context="{'group_by': 'membership_type'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Menu -->
  <menuitem id="menu_bcci_root"         name="BCCI Portal"          sequence="90"/>
  <menuitem id="menu_bcci_applications" name="Membership Applications"
            parent="menu_bcci_root"    action="action_bcci_membership_applications" sequence="1"/>
</odoo>
