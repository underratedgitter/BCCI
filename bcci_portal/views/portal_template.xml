<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="portal_page" name="BCCI Bharuch Portal">
    <t t-call="web.layout">
      <t t-set="head">
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover"/>
        <meta name="theme-color" content="#0F2C59"/>
        <meta name="apple-mobile-web-app-capable" content="yes"/>
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
        <meta name="description" content="Official portal of Bharuch Chamber of Commerce &amp; Industry (BCCI). Apply for institutional membership, access trade support, verify certificates, and connect with Asia's industrial hub."/>
        <meta property="og:title" content="Bharuch Chamber of Commerce &amp; Industry (BCCI) | Official Portal"/>
        <meta property="og:description" content="Official portal of Bharuch Chamber of Commerce &amp; Industry (BCCI). Apply for institutional membership and member services."/>
        <meta property="og:type" content="website"/>
        <title>Bharuch Chamber of Commerce &amp; Industry (BCCI) | Official Portal</title>

        <!-- BCCI Favicon -->
        <link rel="icon" type="image/webp" t-att-href="'/bcci_portal/static/assets/BCCIBHARUCH.webp'"/>
        <link rel="shortcut icon" type="image/webp" t-att-href="'/bcci_portal/static/assets/BCCIBHARUCH.webp'"/>
        <link rel="apple-touch-icon" t-att-href="'/bcci_portal/static/assets/BCCIBHARUCH.webp'"/>

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@500;600;700;800&amp;display=swap" rel="stylesheet"/>

        <!-- FontAwesome 6 -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>

        <!-- Google Identity Services SDK -->
        <script src="https://accounts.google.com/gsi/client" async="async" defer="defer"/>

        <!-- BCCI Custom Stylesheet -->
        <link rel="stylesheet" t-att-href="'/bcci_portal/static/css/styles.css?v=11.0.0'"/>

      </t>

      <!-- Prevent Odoo from injecting its own navbar/footer -->
      <t t-set="no_header" t-value="True"/>
      <t t-set="no_footer" t-value="True"/>

      <!-- ======================================================
           BCCI PORTAL BODY — Full site injected here
           The only changes from index.html are:
             css/styles.css  →  /bcci_portal/static/css/styles.css
             js/app.js       →  /bcci_portal/static/js/app.js
             js/store.js     →  /bcci_portal/static/js/store.js
             assets/X        →  /bcci_portal/static/assets/X
           ====================================================== -->
      <body>
        <!-- Odoo hides its own UI; we render our full custom body via JS include -->
        <div id="bcci-portal-root">
          <!-- This div is replaced by the portal app.js after load -->
        </div>


        <!-- BCCI App Entry Point -->
        <script type="module" t-att-src="'/bcci_portal/static/js/app.js?v=16.0.0'"/>
      </body>
    </t>
  </template>
</odoo>
