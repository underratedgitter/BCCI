# ════════════════════════════════════════════════════════════════════
# BCCI Bharuch Portal — Environment Variables
# Copy this to .env.local for local development
# Add these in Vercel Dashboard → Settings → Environment Variables
# ════════════════════════════════════════════════════════════════════

# ── Upstash Redis (Required) ────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# ── Gmail SMTP for OTP + Production Emails (Required) ───────────────
# Use a Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-16-char-app-password

# ── Admin Credentials (Required) ────────────────────────────────────
# Used for admin portal login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_EMAILS=admin@bccibharuch.in,sp9023156004@gmail.com

# ── Email Configuration (Required) ──────────────────────────────────
# RESEND_API_KEY: Get from https://resend.com (free tier: 100/day)
# Falls back to Gmail SMTP if not set
RESEND_API_KEY=re_your_key_here

# EMAIL_FROM: The "from" address shown to recipients
# Default: BCCI Bharuch <onboarding@resend.dev> (Resend sandbox)
# For production with Resend: use your verified domain
# For SMTP: uses GMAIL_USER automatically
EMAIL_FROM=BCCI Bharuch <noreply@bccibharuch.in>

# ── Cron Secret (Required for Renewal Reminders) ────────────────────
# Generate a random secret string for Vercel Cron authentication
# Example: openssl rand -hex 32
CRON_SECRET=your-random-secret-string-here

# ── CORS (Optional) ────────────────────────────────────────────────
# Set to your production domain for security
ALLOWED_ORIGIN=https://bccibharuch.vercel.app

# ── Admin Notification Email ────────────────────────────────────────
# Where admin notifications are sent
ADMIN_EMAIL=sp9023156004@gmail.com
