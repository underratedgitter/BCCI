# ════════════════════════════════════════════════════════════════════
# BCCI Bharuch Portal — Environment Variables
# Copy to .env.local for local development.
# In production, set these in Vercel → Settings → Environment Variables.
#
# Every value below is a PLACEHOLDER. Never commit real credentials.
# ════════════════════════════════════════════════════════════════════

# ── Upstash Redis (required) ────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# ── SMTP for OTP + notification email (required) ────────────────────
# Gmail / Google Workspace:
#   port 465 → SSL      (implicit TLS; set SMTP_SECURE=true or leave unset)
#   port 587 → STARTTLS (set SMTP_PORT=587; SMTP_SECURE is then false)
# Either works. TLS is required on 587 — the app refuses to send if the
# server will not upgrade, so a password is never sent in the clear.
#
# SMTP_PASS must be an App Password, not the account password:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admin@bccibharuch.in
SMTP_PASS=your-16-char-app-password

# The From address recipients see.
#
# Gmail and Workspace only honour a From address that is either the
# SMTP_USER itself or a verified "Send mail as" alias on that account.
# Anything else is silently rewritten back to SMTP_USER — so keep this
# matching SMTP_USER unless you have added the alias in Gmail settings.
# Run `npm run mail:test` to check.
EMAIL_FROM=BCCI Bharuch <admin@bccibharuch.in>

# ── Admin portal (required) ─────────────────────────────────────────
# Comma-separated list of addresses allowed to sign in as admin.
# These also receive new-application notifications.
ADMIN_EMAILS=admin@example.com
ADMIN_PASSWORD=set-a-long-random-password

# ── Internal API secret (required) ──────────────────────────────────
# Authorises server-to-server calls to /api/send-email. Generate with:
#   openssl rand -hex 32
INTERNAL_API_SECRET=generate-a-random-secret

# ── CORS (required in production) ───────────────────────────────────
# Comma-separated list of origins allowed to call the API from a browser.
ALLOWED_ORIGIN=https://bccibharuch.in
