{
  "name": "bcci-bharuch-portal",
  "version": "5.0.0",
  "description": "BCCI Bharuch Chamber of Commerce & Industry — Official Membership Portal",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env.local server.js",
    "dev:sandbox": "node scripts/dev-sandbox.mjs",
    "dev:vercel": "vercel dev",
    "deploy": "vercel --prod",
    "test": "node scripts/run-tests.mjs",
    "mail:test": "node --env-file-if-exists=.env.local scripts/test-mail.mjs",
    "test:e2e": "node tests/e2e.test.mjs",
    "test:email": "node tests/email-outbox.test.mjs",
    "test:smtp": "node tests/smtp-config.test.mjs",
    "test:api": "node tests/api.test.mjs",
    "test:data": "node tests/data.test.mjs",
    "test:client": "node tests/client.test.mjs",
    "test:auth": "node tests/applicant-auth.test.mjs",
    "test:events": "node tests/events-redis.test.mjs && node tests/events-api.test.mjs",
    "test:browser": "node scripts/site-browser-test.mjs",
    "test:leadership-browser": "node scripts/leadership-browser-test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test:purge": "node tests/purge.test.mjs",
    "purge:data": "node --env-file-if-exists=.env.local scripts/purge-data.mjs",
    "test:board": "node tests/board.test.mjs",
    "versions:check": "node scripts/asset-versions.mjs",
    "versions:update": "node scripts/asset-versions.mjs --update"
  },
  "dependencies": {
    "@upstash/redis": "^1.40.0",
    "nodemailer": "^10.3.1"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
